# Copy to .env, then set a unique random password before starting.
ADMIN_PASSWORD=replace-with-a-long-random-password
# Local HTTP demo only. Use an HTTPS origin and COOKIE_SECURE=true in production.
BASE_URL=http://127.0.0.1:18076
COOKIE_SECURE=false
COOKIE_MAX_AGE=86400
MAX_UPLOAD_BYTES=5242880
BIND_HOST=127.0.0.1
BIND_PORT=18076
